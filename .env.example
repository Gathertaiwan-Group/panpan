# ===== apps/web (Vercel) =====
# 品牌頁全部可留空：未設定時整站以 packages/content/content.json 顯示，表單回傳友善錯誤。
NEXT_PUBLIC_SITE_URL=https://panpan-ashen.vercel.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_LINE_URL=

# ===== 線上預約／後台（伺服器端專用，絕不可加 NEXT_PUBLIC_ 前綴） =====
# 未設定 SUPABASE_SERVICE_ROLE_KEY 或 PChomePay 金鑰時，線上預約自動視為未開放（維持預約詢問表單）。
SUPABASE_SERVICE_ROLE_KEY=
# PChomePay 支付連（與給樂官網同一組商店金鑰；本站訂單編號一律 DD 開頭）
PCHOMEPAY_APP_ID=
PCHOMEPAY_SECRET=
# true = 測試環境（sandbox）；正式上線改 false
PCHOMEPAY_SANDBOX=
# 允許的付款方式（逗號分隔）：CARD,ATM
PCHOMEPAY_PAY_TYPES=
# Resend（未設定 → 通知信 dry-run 只記 log）
RESEND_API_KEY=
# 寄件人，例：朵朵曉語 <noreply@gathertaiwan.com>
MAIL_FROM=
# 管理員通知信收件人（新預約、需人工處理）；留空則不寄
ADMIN_NOTIFY_EMAIL=
